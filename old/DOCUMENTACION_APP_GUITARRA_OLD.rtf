\pard\intbl\ql\sl240\slmult1{\f0\fs20\cf2 Arquitectura de C\'f3digo}\cell\pard\intbl\qc\sl240\slmult1{\f0\fs20\cf2 Archivo monol\'edtico neckmodule.js de 1362 l\'edneas con manipulaci\'f3n manual de strings HTML.}\cell\pard\intbl\qc\sl240\slmult1{\f0\fs20\cf2 Dificulta el mantenimiento, la adici\'f3n de nuevos instrumentos o afinaciones y produce c\'f3digo dif\'edcil de testear.}\cell\row
