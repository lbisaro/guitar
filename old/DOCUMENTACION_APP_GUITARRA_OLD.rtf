\pard\intbl\ql\sl240\slmult1{\f0\fs20\cf2 Persistencia de Estado}\cell\pard\intbl\qc\sl240\slmult1{\f0\fs20\cf2 Uso de divs ocultos con clase '.meta' inyectados en el DOM para almacenar configuraciones.}\cell\pard\intbl\qc\sl240\slmult1{\f0\fs20\cf2 Mecanismo fr\'e1gil y poco convencional que complica la sincronizaci\'f3n de estado y la reactividad.}\cell\row
